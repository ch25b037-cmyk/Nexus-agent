# Database Connection (PostgreSQL with pgvector extension)
DATABASE_URL=postgresql+psycopg://username:password@host:5432/postgres

# LLM Inference (Groq or OpenAI-compatible)
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.1-8b-instant

# Dense Vector Embeddings (Google Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here

# Video / Audio Briefing (Optional if using Edge-TTS fallback)
HEYGEN_API_KEY=your_heygen_key_optional

# Multi-Tenant Authentication
JWT_SECRET_KEY=nexus-super-secret-jwt-key-2026